# 站点对外 URL（SEO / OG）— 本地请统一用 localhost，勿混用 127.0.0.1（Cookie/跳转会断）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 浏览器直连 API；本地留空走 Next rewrite → API_PROXY_TARGET
NEXT_PUBLIC_API_BASE_URL=

# Next 服务端 / rewrite 代理到国际后端
API_PROXY_TARGET=http://127.0.0.1:7033

# 用户中心（登录 / 我的票）
NEXT_PUBLIC_USER_CENTER_URL=http://localhost:5174

# 与用户中心共享 Cookie 时配置父域；本地留空
NEXT_PUBLIC_COOKIE_DOMAIN=
